# Copy to .env and edit. All vars are optional; defaults run the MOCK provider.
LUXE_PROVIDER=mock            # mock | openai | replicate
# LUXE_PROVIDER=openai
# OPENAI_API_KEY=sk-...
LUXE_OPENAI_MODEL=gpt-image-1
LUXE_VISION_MODEL=gpt-4o-mini
LUXE_IMAGE_SIZE=1536x1024
LUXE_IMAGE_QUALITY=high
LUXE_CONTROL_MODE=depth        # depth | canny | none
LUXE_OUT_DIR=./renders
LUXE_PUBLIC_BASE=/renders
LUXE_CORS_ORIGINS=*
# Phase B:
# REPLICATE_API_TOKEN=r8_...
# LUXE_REPLICATE_MODEL=black-forest-labs/flux-...
# API integration
LUXE_API_KEY=change-me-in-production
LUXE_JOB_DB=./luxe_jobs.sqlite3
LUXE_JOB_WORKERS=1
LUXE_VIEWER_BASE=/viewer
